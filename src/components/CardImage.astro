---
// Article photo, or (when there is none) a deliberate typographic cover in the
// brand colours so pages never look empty or unfinished.
import { CATEGORIES, url, type CategorySlug } from '../lib/site';

interface Props {
  image?: string;
  category: CategorySlug;
  lang: 'en' | 'mr';
  href: string;
  large?: boolean;
  lazy?: boolean;
}
const { image, category, lang, href, large = false, lazy = true } = Astro.props;
const label = lang === 'mr' ? CATEGORIES[category].mr : CATEGORIES[category].en;
---
<a href={href} class:list={['card-img', { cover: !image, large }]} tabindex="-1" aria-hidden="true">
  {image ? (
    <img src={url(image)} alt="" loading={lazy ? 'lazy' : 'eager'} />
  ) : (
    <span class="cover-inner" lang={lang}>
      <svg width={large ? 44 : 32} height={large ? 44 : 32} viewBox="0 0 48 48" fill="none">
        <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="2" opacity=".55" />
        <path d="M8 24c4.5-7 10-10.5 16-10.5S35.5 17 40 24c-4.5 7-10 10.5-16 10.5S12.5 31 8 24Z" stroke="#f8f4ec" stroke-width="2" />
        <circle cx="24" cy="24" r="6" fill="currentColor" />
      </svg>
      <span class="cover-label">{label}</span>
    </span>
  )}
</a>

<style>
  .card-img.cover {
    background:
      radial-gradient(120% 90% at 85% 10%, rgba(180, 138, 62, 0.28), transparent 60%),
      linear-gradient(160deg, var(--navy-2), var(--navy));
    color: var(--gold);
    display: grid;
    place-items: center;
    text-decoration: none;
  }
  .cover-inner {
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 16px;
    text-align: center;
  }
  .cover-label {
    font-family: var(--serif);
    font-size: 1.05rem;
    color: var(--gold-soft);
    letter-spacing: 0.04em;
  }
  .large .cover-label { font-size: 1.5rem; }
</style>
