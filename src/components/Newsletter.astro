---
import { SITE } from '../lib/site';

interface Props { lang?: 'en' | 'mr' }
const { lang = 'en' } = Astro.props;
const mr = lang === 'mr';
const { action, emailField } = SITE.newsletter;
const channel = SITE.whatsapp.channel;

const t = mr
  ? {
      kicker: 'वृत्तपत्र',
      title: 'नवीन लेख थेट तुमच्या इनबॉक्समध्ये',
      body: 'राजकारण, समाज आणि लोकांच्या गोष्टींवरील नवीन लेख ईमेलद्वारे मिळवा. स्पॅम नाही, कधीही सदस्यत्व रद्द करा.',
      label: 'तुमचा ईमेल',
      placeholder: 'तुमचा ईमेल पत्ता',
      button: 'सदस्य व्हा',
      thanks: 'धन्यवाद! तुमचे सदस्यत्व पक्के करण्यासाठी तुमचा ईमेल तपासा.',
      soon: 'वृत्तपत्र लवकरच सुरू होत आहे.',
      or: 'किंवा',
      wa: 'व्हॉट्सॲपवर फॉलो करा',
    }
  : {
      kicker: 'Newsletter',
      title: 'New writing, straight to your inbox',
      body: 'Get new articles on politics, society and ground stories by email, in English and Marathi. No spam. Unsubscribe anytime.',
      label: 'Your email',
      placeholder: 'you@example.com',
      button: 'Subscribe',
      thanks: 'Thank you! Please check your email to confirm your subscription.',
      soon: 'The newsletter is launching soon.',
      or: 'or',
      wa: 'Follow on WhatsApp',
    };
---
<section class="newsletter" aria-labelledby="newsletter-title" data-pagefind-ignore>
  <div class="wrap newsletter-inner">
    <div class="newsletter-copy">
      <div class="newsletter-kicker">{t.kicker}</div>
      <h2 id="newsletter-title">{t.title}</h2>
      <p>{t.body}</p>
    </div>
    <form
      class="newsletter-form"
      action={action || undefined}
      method="post"
      target="_blank"
      data-newsletter
      data-configured={action ? 'yes' : 'no'}
      data-thanks={t.thanks}
      data-soon={t.soon}
    >
      <label class="visually-hidden" for="newsletter-email">{t.label}</label>
      <input
        id="newsletter-email"
        type="email"
        name={emailField}
        required
        autocomplete="email"
        inputmode="email"
        placeholder={t.placeholder}
      />
      <input type="hidden" name="tag" value={mr ? 'marathi' : 'english'} />
      <button type="submit">{t.button}</button>
      <p class="newsletter-status" role="status" aria-live="polite"></p>
      {channel && (
        <div class="newsletter-wa">
          <span>{t.or}</span>
          <a href={channel} target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3Z"/></svg>
            {t.wa}
          </a>
        </div>
      )}
    </form>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.newsletter-status')!;
    form.addEventListener('submit', (e) => {
      if (form.dataset.configured !== 'yes') {
        e.preventDefault();
        status.textContent = form.dataset.soon ?? '';
        return;
      }
      // The service opens its confirmation page in a new tab; show a note here too.
      setTimeout(() => {
        status.textContent = form.dataset.thanks ?? '';
        form.reset();
      }, 50);
    });
  });
</script>

<style>
  .newsletter {
    background: var(--gold-soft);
    border-top: 3px solid var(--gold);
    padding: 44px 0;
  }
  .newsletter-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 32px;
    align-items: center;
  }
  .newsletter-kicker {
    color: var(--gold-text);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .newsletter h2 {
    font-family: var(--serif);
    color: var(--navy);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    line-height: 1.25;
    margin: 6px 0 8px;
  }
  .newsletter p {
    margin: 0;
    color: var(--charcoal);
    max-width: 52ch;
  }
  .newsletter-form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .newsletter-form input[type='email'] {
    flex: 1 1 220px;
    min-width: 0;
    padding: 12px 16px;
    font: inherit;
    font-size: 1rem;
    border: 1px solid #cdbf9f;
    border-radius: 999px;
    background: var(--paper);
    color: var(--charcoal);
  }
  .newsletter-form input[type='email']:focus {
    outline: 2px solid var(--navy);
    outline-offset: 1px;
  }
  .newsletter-form button {
    flex: none;
    padding: 12px 22px;
    border: 0;
    border-radius: 999px;
    background: var(--navy);
    color: var(--ivory);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .newsletter-form button:hover { background: var(--navy-2); }
  .newsletter-status {
    flex-basis: 100%;
    font-size: 0.92rem;
    color: var(--navy);
    min-height: 1.4em;
  }
  .newsletter-wa {
    flex-basis: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .newsletter-wa a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 18px;
    border-radius: 999px;
    background: #1f7a4d;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .newsletter-wa a:hover { background: #18633e; color: #fff; }
  @media (max-width: 760px) {
    .newsletter { padding: 36px 0; }
    .newsletter-inner { grid-template-columns: 1fr; gap: 20px; }
    .newsletter-form button { flex: 1 1 100%; }
  }
</style>
