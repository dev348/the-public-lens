---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CardImage from '../components/CardImage.astro';
import { getArticles, articlePath } from '../lib/articles';
import { SITE, CATEGORIES, CATEGORY_SLUGS, url, formatDate } from '../lib/site';

const english = await getArticles({ lang: 'en' });
const marathi = await getArticles({ lang: 'mr' });
const lead = english.find((a) => a.data.featured) ?? english[0];
const rest = english.filter((a) => a !== lead).slice(0, 6);
---
<Base current="home">
  <div class="wrap">
    <section class="hero">
      <h1 class="visually-hidden">The Public Lens: independent writing in English and Marathi</h1>
      <p class="hero-tag">{SITE.tagline}</p>

      {lead ? (
        <div class="lead">
          <CardImage image={lead.data.image} category={lead.data.category} lang={lead.data.lang} href={url(articlePath(lead))} large lazy={false} />
          <div>
            <div class="meta"><a class="cat" href={url(`/${lead.data.category}/`)}>{CATEGORIES[lead.data.category].en}</a></div>
            <h2><a href={url(articlePath(lead))}>{lead.data.title}</a></h2>
            <p>{lead.data.description}</p>
            <div class="meta">
              <span>{lead.data.author}</span><span aria-hidden="true">·</span>
              <time datetime={lead.data.date.toISOString()}>{formatDate(lead.data.date)}</time>
            </div>
          </div>
        </div>
      ) : (
        <p class="empty-note">No articles yet. New writing is on the way.</p>
      )}
    </section>

    {rest.length > 0 && (
      <>
        <div class="section-title"><h2>Latest</h2></div>
        <div class="cards">{rest.map((a) => <ArticleCard article={a} />)}</div>
      </>
    )}

    <div class="section-title">
      <h2 lang="mr">मराठी लेख</h2>
      <a href={url('/mr/')} lang="mr">सर्व मराठी लेख →</a>
    </div>
    {marathi.length > 0 ? (
      <div class="cards">{marathi.slice(0, 3).map((a) => <ArticleCard article={a} />)}</div>
    ) : (
      <p class="empty-note" lang="mr">लवकरच मराठी लेख येत आहेत.</p>
    )}

    <div class="section-title"><h2>Sections</h2></div>
    <div class="cat-grid">
      {CATEGORY_SLUGS.map((s) => (
        <a class="cat-tile" href={url(`/${s}/`)}>
          <strong>{CATEGORIES[s].en}</strong>
          <span>{CATEGORIES[s].blurb}</span>
        </a>
      ))}
    </div>
  </div>
</Base>
