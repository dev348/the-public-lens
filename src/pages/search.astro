---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
const bundle = url('/pagefind/');
---
<Base title="Search" current="search">
  <link slot="head" rel="stylesheet" href={`${bundle}pagefind-ui.css`} />
  <div class="wrap narrow">
    <header class="page-head">
      <div class="kicker">Search · <span lang="mr">शोधा</span></div>
      <h1>Search articles</h1>
      <p>Search across every English and Marathi article by topic, place, name or word.</p>
    </header>
    <div id="search" class="search-box" data-bundle={bundle}></div>
    <noscript><p>Search needs JavaScript turned on.</p></noscript>
  </div>
  <script is:inline define:vars={{ bundle }}>
    const s = document.createElement('script');
    s.src = bundle + 'pagefind-ui.js';
    s.onload = () => {
      const ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: false, bundlePath: bundle });
      const q = new URLSearchParams(location.search).get('q');
      if (q) ui.triggerSearch(q);
    };
    s.onerror = () => {
      document.getElementById('search').innerHTML =
        '<p class="empty-note">Search is available on the published site (it is built when the site is deployed).</p>';
    };
    document.body.appendChild(s);
  </script>
</Base>
